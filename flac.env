# The one place the version lives.
#
# `FLAC_SHA256` is checked before anything is unpacked, so a tarball that is not the one this
# repository was pinned to stops the build instead of silently becoming the library everything
# links against. Recompute it when bumping:
#
#   curl -sSLO https://github.com/xiph/flac/releases/download/<version>/flac-<version>.tar.xz
#   shasum -a 256 flac-<version>.tar.xz
#
# A tarball checksum rather than a commit: FLAC publishes release tarballs, as assets on its
# GitHub releases and on downloads.xiph.org, and both hosts serve the same bytes. The tarball
# is also what carries the release's own version strings — a git checkout names itself after
# its commit instead.
FLAC_VERSION=1.5.0
FLAC_SHA256=f2c1c76592a82ffff8413ba3c4a1299b6c7ab06c734dee03fd88630485c2b920
FLAC_URL=https://github.com/xiph/flac/releases/download

# Where the built archives are published. Read by sync-prebuilt.sh and by
# crates/libflac-prebuilt-sys/build.rs, so that a fork changes this in one place rather than in
# two scripts and a build script.
PREBUILT_REPO=andrewtheguy/libflac-prebuilt
